#!/usr/bin/env bash
# speckit: say which lane runs next on a card, from its handoffs.md.
# Usage: next [specs/<dir> ...]
#   No arguments: the card of the current branch, or every card in specs/.

set -euo pipefail

lanes=(specifier spec-review coder cleaner architect hardener qa)

skill_for() {
    case "$1" in
        specifier) echo speckit-specify ;;
        spec-review) echo speckit-spec-review ;;
        coder) echo speckit-implement ;;
        cleaner) echo speckit-refactor ;;
        architect) echo speckit-architecture ;;
        hardener) echo speckit-review ;;
        qa) echo speckit-verify ;;
        *) return 1 ;;
    esac
}

lane_after() {
    local i
    for i in "${!lanes[@]}"; do
        if [ "${lanes[$i]}" = "$1" ]; then
            [ "$i" -lt $((${#lanes[@]} - 1)) ] && echo "${lanes[$((i + 1))]}"
            return 0
        fi
    done
    return 1
}

run() { echo "$1: run /$(skill_for "$2") ($2) in a fresh session"; }

status() {
    local dir=${1%/} last lane verdict target
    if [ ! -f "$dir/task.md" ]; then
        echo "$dir: no task.md. Create the card with /speckit-add-task"
        return
    fi
    last=''
    if [ -f "$dir/handoffs.md" ]; then
        last=$(grep -E '^- [0-9]{4}-[0-9]{2}-[0-9]{2} [a-z-]+: ' "$dir/handoffs.md" | tail -n 1 || true)
    fi
    if [ -z "$last" ]; then
        if [ -f "$dir/spec.md" ]; then
            echo "$dir: no hand-off recorded, but spec.md exists. Check the last lane's output"
        else
            run "$dir" specifier
        fi
        return
    fi

    lane=$(printf '%s\n' "$last" | sed -E 's/^- [0-9-]+ ([a-z-]+): .*/\1/')
    verdict=$(printf '%s\n' "$last" | sed -E 's/^- [0-9-]+ [a-z-]+: //')

    case "$verdict" in
        pass*)
            if [ "$lane" = qa ]; then
                echo "$dir: qa passed. Merge the branch"
            elif target=$(lane_after "$lane"); then
                run "$dir" "$target"
            else
                echo "$dir: unknown lane '$lane' in the last hand-off"
            fi
            ;;
        return\ *)
            target=$(printf '%s\n' "$verdict" | awk '{ print $2 }')
            if skill_for "$target" > /dev/null; then
                run "$dir" "$target"
            else
                echo "$dir: the last hand-off returns to an unknown lane '$target'"
            fi
            ;;
        stop*) echo "$dir: parked" ;;
        *) echo "$dir: can't read the last hand-off" ;;
    esac
    echo "  last: ${last#- }"
}

if [ "$#" -eq 0 ]; then
    branch=$(git symbolic-ref --short -q HEAD 2> /dev/null || true)
    if [ -n "$branch" ] && [ -d "specs/${branch//\//-}" ]; then
        set -- "specs/${branch//\//-}"
    else
        shopt -s nullglob
        for dir in specs/*/; do
            [ -f "$dir/task.md" ] && set -- "$@" "$dir"
        done
        if [ "$#" -eq 0 ]; then
            echo "No cards in specs/. Create one with /speckit-add-task"
            exit 0
        fi
    fi
fi

for dir in "$@"; do
    if [ ! -d "$dir" ]; then
        echo "next: $dir is not a directory" >&2
        exit 1
    fi
    status "$dir"
done
